# Copy to backend/.env and fill in values. Names only are committed; never commit real values.

# development | test | production
NODE_ENV=development
# development | test | demo | production. The test OTP is shown on screen only when this is NOT production.
APP_ENV=development
PORT=4000
# PostgreSQL connection string (local Docker: see docker-compose.yml)
DATABASE_URL=
# Public URL of the frontend (used for the CSRF origin check)
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
OTP_PEPPER=
# Shared secret for the scheduled reminder job (optional; at least 32 characters)
CRON_SECRET=
